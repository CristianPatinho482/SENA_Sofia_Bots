{
  "_LEEME": [
    "Plantilla de flujo en la nube para el boton de Power BI.",
    "No es un paquete .zip importable: pega el objeto 'definition' en Power Automate",
    "con 'Mis flujos > ... > Peek code' o crea el flujo siguiendo power_automate/LEEME.md.",
    "Reemplaza los marcadores DESKTOP_FLOW_ID y las conexiones antes de guardar."
  ],
  "nombre_sugerido": "SOFIABOT - Descargar inasistencias (boton Power BI)",
  "descripcion": "Se dispara cuando el usuario pulsa el boton del reporte. Ejecuta el flujo de escritorio que abre el bot interactivo; solo pide credenciales la primera vez o si Sofia Plus exige cambiarlas.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "DesktopFlowId": {
        "defaultValue": "DESKTOP_FLOW_ID",
        "type": "String"
      }
    },
    "triggers": {
      "Cuando_se_pulsa_un_boton_de_Power_BI": {
        "type": "ApiConnectionWebhook",
        "inputs": {
          "host": {
            "connection": {
              "name": "@parameters('$connections')['shared_powerbi']['connectionId']"
            }
          },
          "body": {},
          "path": "/trigger/powerbi/buttons"
        },
        "splitOn": "@triggerOutputs()?['body/rows']"
      }
    },
    "actions": {
      "Ejecutar_bot_de_inasistencias": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "name": "@parameters('$connections')['shared_uiflow']['connectionId']"
            }
          },
          "method": "post",
          "path": "/flows/@{encodeURIComponent(parameters('DesktopFlowId'))}/run",
          "body": {
            "runMode": "attended",
            "runSession": "desktop",
            "runPriority": "normal",
            "uiFlowId": "@parameters('DesktopFlowId')",
            "item": {}
          }
        },
        "runAfter": {}
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_powerbi": {
      "connectionName": "shared_powerbi",
      "source": "Embedded"
    },
    "shared_uiflow": {
      "connectionName": "shared_uiflow",
      "source": "Embedded"
    }
  },
  "flujo_escritorio_esperado": {
    "nombre": "SOFIABOT - Inasistencias interactivo",
    "accion_1": "Ejecutar aplicacion: ejecutar_inasistencias.bat",
    "accion_2": "Esperar a que termine el proceso",
    "observacion": "El .bat abre el bot con interfaz grafica. Si no existen credenciales en .env, el bot las pide y las guarda."
  }
}
